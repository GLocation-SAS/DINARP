sequenceDiagram
    autonumber
    actor CS as Coordinador SINARP
    participant SAU
    participant SURI as Plataforma SURI (Interoperabilidad)
    participant DGR as Dir. Gestión y Registro
    participant DPI as Dir. Protección de la Información
    participant MAIL as Correo electrónico
    participant SVC as Servicio de interoperabilidad
    participant SYT as Seguridad y Tecnología

    rect rgba(90,140,255,0.12)
    Note over CS,DGR: Fase Solicitud
    CS->>SAU: Registrarse
    SAU-->>CS: Usuario habilitado
    loop Hasta solicitud correcta
        CS->>SURI: Ingresar y cargar formatos de acceso
        Note right of CS: Formatos: cambio de coordinador,<br/>solicitud de acceso al SINARP,<br/>acuerdo de uso y confidencialidad
        SURI->>DGR: Solicitud de acceso
        DGR->>DGR: Validar solicitud
        alt Solicitud incorrecta
            DGR-->>CS: Devolver solicitud
        end
    end
    DGR->>SURI: Aprobar solicitud
    SURI-->>CS: Envío automático de credenciales de paquetes
    end

    rect rgba(255,170,60,0.12)
    Note over CS,DPI: Fase Justificación
    CS->>SURI: Seleccionar y justificar campos del Catálogo de Servicios Digitales
    alt Requiere justificación jurídica
        loop Hasta campos justificados correctamente
            SURI->>DPI: Campos seleccionados y justificación
            DPI->>DPI: Verificar condiciones de legitimidad
            alt Campos no justificados
                DPI->>MAIL: Notificar observaciones
                MAIL-->>CS: Correo con observaciones
                CS->>SURI: Ajustar selección o justificación
            end
        end
        DPI->>SURI: Elaborar y cargar informe de justificación
        SURI-->>CS: Justificación disponible
    end
    end

    rect rgba(80,190,120,0.12)
    Note over CS,SYT: Fase Elaboración y entrega
    SURI->>SURI: Crear paquetes
    SURI-->>CS: Notificación de creación de paquetes
    loop Hasta consumo favorable
        CS->>SVC: Realizar pruebas de consumo
        SVC-->>CS: Resultado
        alt Error de consumo
            CS->>SYT: Notificar error (gestión y CIS)
            SYT-->>CS: Soporte ante requerimiento
        end
    end
    Note over CS: Consumo favorable - FIN
    end
