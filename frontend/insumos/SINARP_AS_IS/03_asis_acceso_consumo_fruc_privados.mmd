sequenceDiagram
    autonumber
    actor CS as Coordinador SINARP (entidad privada)
    participant FRUC as Plataforma FRUC
    participant SAU as SAU (Enrolamiento)
    participant DG as Dir. de Gestión
    participant MAIL as Correo electrónico
    participant DPI as Dir. Protección de la Información
    participant FIN as Área Financiera

    CS->>FRUC: Ingresar a la plataforma FRUC
    FRUC->>FRUC: ¿Institución integrada al SINARP?
    alt No integrada
        FRUC-->>CS: Redirigir a enrolamiento
        CS->>SAU: Realizar enrolamiento (registrar y validar datos)
        SAU-->>CS: Acceso habilitado
    end

    rect rgba(90,140,255,0.12)
    Note over CS,MAIL: Fase Solicitud
    CS->>FRUC: Registrar solicitud con documentos habilitantes
    FRUC->>DG: Solicitud para validación
    DG->>DG: ¿Documentos correctos?
    alt Documentos incorrectos
        DG->>MAIL: Enviar mail de negación
        MAIL-->>CS: Correo de negación
        Note over CS: Debe volver a registrar la solicitud
    else Documentos correctos
        DG->>FRUC: Activar link para ingresar al catálogo
        FRUC-->>CS: Link de acceso al catálogo de servicios
    end
    end

    rect rgba(255,170,60,0.12)
    Note over CS,DPI: Fase Selección y justificación de campos
    loop Hasta que los campos estén justificados
        CS->>FRUC: Registrar campos (marcar libre acceso o confidencial, justificar confidenciales)
        FRUC->>FRUC: ¿Campos de libre acceso?
        alt Hay campos confidenciales
            FRUC->>DPI: Solicitar justificación jurídica
            DPI->>DPI: ¿Campos justificados?
            alt No justificados
                DPI->>FRUC: Negar acceso y solicitar corrección
                FRUC-->>CS: Devolución para volver a justificar
            else Justificados
                DPI->>FRUC: Aprobar justificación
                FRUC->>DG: Justificación aprobada
            end
        else Todos de libre acceso
            FRUC->>DG: Solicitud lista para aprobación
        end
    end
    DG->>FRUC: Aprobar solicitud
    end

    rect rgba(220,120,120,0.12)
    Note over CS,FIN: Fase Contratación y pago (prepago)
    DG->>FRUC: Generar contrato
    FRUC-->>CS: Contrato
    DG->>FRUC: Generar factura (campos, fuentes y servicios solicitados)
    FRUC-->>CS: Factura de consumo prepago
    CS->>FIN: Realizar pago
    FIN->>FIN: Verificar pago (subproceso)
    FIN->>DG: Pago confirmado (disparador)
    end

    rect rgba(80,190,120,0.12)
    Note over CS,DG: Fase Habilitación del consumo
    DG->>FRUC: Crear paquetes aprobados
    DG->>CS: Notificar creación de paquetes
    DG->>FRUC: Crear visualizadores
    DG->>FRUC: Asignar paquetes a la entidad
    DG->>FRUC: Activar roles
    CS->>FRUC: Consumir información
    Note over CS,FRUC: FIN
    end
